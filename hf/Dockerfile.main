# Hugging Face Space: cityu-facility-report (main FastAPI system)
# Deploy: create a Docker Space on HF, then push this repo's files to it.
FROM python:3.13-slim
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY app/ app/
COPY ml/ ml/
COPY categories.csv seed_training_data.csv ./
# Train the classifier at build time so the runtime starts instantly.
RUN python ml/train.py
ENV PYTHONUNBUFFERED=1
# HF Spaces requires the app to listen on 7860.
EXPOSE 7860
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "7860"]
