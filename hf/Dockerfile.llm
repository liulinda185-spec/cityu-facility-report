# Hugging Face Space: cityu-llm-demo (Flask LLM demo)
# Deploy: create a Docker Space on HF, then push this repo's files to it.
FROM python:3.13-slim
WORKDIR /app
COPY requirements.txt llm_webapp/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt -r llm_webapp/requirements.txt
COPY app/ app/
COPY llm_webapp/ llm_webapp/
COPY ml/ ml/
COPY categories.csv seed_training_data.csv ./
# Train the classifier at build time so the runtime starts instantly.
RUN python ml/train.py
ENV PYTHONUNBUFFERED=1 \
    PORT=7860 \
    CHAT_BACKEND=openai \
    CLASSIFY_BACKEND=local_model \
    OPENAI_BASE_URL=https://api.deepseek.com/v1 \
    OPENAI_MODEL=deepseek-chat
# OPENAI_API_KEY must be set as a Space Secret (Settings -> Variables and secrets).
# HF Spaces requires the app to listen on 7860.
EXPOSE 7860
CMD ["python", "llm_webapp/app.py"]
