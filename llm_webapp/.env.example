# ===== llm_webapp 环境变量样例 =====
# 推荐用法：复制为 .env 并填写（程序启动时会自动读取 .env）
#   复制命令:  Copy-Item .env.example .env
# 或在 PowerShell 里临时设置：
#   $env:CHAT_BACKEND = "openai"

# 对话后端: mock | openai | ollama
CHAT_BACKEND=mock

# 工单分类后端: local_model | openai | ollama | mock
CLASSIFY_BACKEND=local_model

# --- DeepSeek / OpenAI 兼容 API（把 CHAT_BACKEND 设为 openai 时填写）---
# OPENAI_API_KEY=sk-你的key
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-chat

# --- Ollama 本地模型（把 CHAT_BACKEND / CLASSIFY_BACKEND 设为 ollama 时填写）---
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# Web 端口
LLM_WEBAPP_PORT=5050
